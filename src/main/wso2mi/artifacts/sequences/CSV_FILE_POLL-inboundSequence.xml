<?xml version="1.0" encoding="UTF-8"?>
<sequence name="CSV_FILE_POLL-inboundSequence" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <log category="INFO" logMessageID="false" logFullPayload="false">
        <message>
            ------------------------------
            FILE EVENT TRIGGER
            ------------------------------
        </message>
    </log>
    <variable name="csvData" expression="${payload.text}" type="STRING"/>
    <datamapper config="resources:datamapper/CSVtoXML/CSVtoXML.dmc" inputSchema="resources:datamapper/CSVtoXML/CSVtoXML_inputSchema.json" inputType="CSV" outputSchema="resources:datamapper/CSVtoXML/CSVtoXML_outputSchema.json" outputType="XML"/>
    <validate source="${payload}" cache-schema="true">
        <schema key="resources:xsd/employee.xsd"/>
        <on-fail>
            <variable name="errorDetail" expression="${props.synapse.ERROR_MESSAGE}" type="STRING"/>
            <log category="ERROR">
                <message>XSD validation failed: ${vars.errorDetail}</message>
            </log>
            <throwError type="VALIDATION_ERROR" errorMessage="XML failed XSD validation"/>
        </on-fail>
    </validate>
    <!-- 1. Fetch input CSV file name from transport -->
    <property name="incomingFileName" expression="get-property('transport', 'FILE_NAME')" scope="default" type="STRING"/>
    <!-- 2. Construct output XML file name -->
    <property name="outputFileName" expression="fn:concat(fn:substring-before($ctx:incomingFileName, '.csv'), '.xml')" scope="default" type="STRING"/>
    <!-- 3. Read environment paths -->
    <property name="backUp" expression="get-property('env', 'BACKUP_DIR')" scope="default" type="STRING"/>
    <property name="doneDir" expression="get-property('env', 'DONE_DIR')" scope="default" type="STRING"/>
    <property name="watchDir" expression="get-property('env', 'WATCH_DIR')" scope="default" type="STRING"/>
    <!-- 4. Construct target path for XML output and source CSV absolute path -->
    <property name="targetXmlFilePath" expression="fn:concat($ctx:doneDir, '/', $ctx:outputFileName)" scope="default" type="STRING"/>
    <property name="sourceCsvFilePath" expression="fn:concat($ctx:watchDir, '/', $ctx:incomingFileName)" scope="default" type="STRING"/>
    <!-- 5. Write converted XML to DONE_DIR -->
    <file.write configKey="LocalRoot">
        <filePath>{$ctx:targetXmlFilePath}</filePath>
        <contentOrExpression>${payload}</contentOrExpression>
        <encoding>UTF-8</encoding>
        <mimeType>application/xml</mimeType>
        <compress>false</compress>
        <writeMode>Overwrite</writeMode>
        <enableStreaming>false</enableStreaming>
        <appendNewLine>false</appendNewLine>
        <enableLock>false</enableLock>
        <updateLastModified>true</updateLastModified>
        <maxRetries>0</maxRetries>
        <retryDelay>0</retryDelay>
        <timeBetweenSizeCheck></timeBetweenSizeCheck>
        <updateFilePermission></updateFilePermission>
        <diskShareAccessMask>MAXIMUM_ALLOWED</diskShareAccessMask>
        <responseVariable>file_write_1</responseVariable>
        <overwriteBody>false</overwriteBody>
    </file.write>
    <!-- 6. Move original CSV file to BACKUP_DIR directory -->
    <file.move configKey="LocalRoot">
        <sourcePath>{$ctx:sourceCsvFilePath}</sourcePath>
        <targetPath>{$ctx:backUp}</targetPath>
        <createParentDirectories>true</createParentDirectories>
        <includeParent>false</includeParent>
        <overwrite>true</overwrite>
        <renameTo></renameTo>
        <filePattern></filePattern>
        <fileFilterType>ant</fileFilterType>
        <includeFiles></includeFiles>
        <excludeFiles></excludeFiles>
        <maxFileAge></maxFileAge>
        <timeBetweenSizeCheck></timeBetweenSizeCheck>
        <isSourceMounted></isSourceMounted>
        <isTargetMounted></isTargetMounted>
        <diskShareAccessMask>MAXIMUM_ALLOWED</diskShareAccessMask>
        <responseVariable>file_move_1</responseVariable>
        <overwriteBody>false</overwriteBody>
    </file.move>
    <dbreport>
        <connection>
            <pool>
                <dsName>jdbc/PgDS</dsName>
            </pool>
        </connection>
        <statement>
            <sql><![CDATA[INSERT INTO file_transactions (file_path, success, error_reason, csv_data, result_xml) VALUES (?, TRUE, NULL, ?, ?)]]></sql>
            <parameter expression="${props.synapse.sourceCsvFilePath}" type="VARCHAR"/>
            <parameter expression="${vars.csvData}" type="VARCHAR"/>
            <parameter expression="${payload}" type="VARCHAR"/>
        </statement>
    </dbreport>
    <log category="INFO" logMessageID="false" logFullPayload="false">
        <message>
            ------------------------------
            SUCCESS: XML written and CSV moved to DONE_DIR
            ------------------------------
        </message>
    </log>
</sequence>